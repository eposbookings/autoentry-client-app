         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Partnership (short) (2026)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq/>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>partner tax records</rdf:li>
               <rdf:li>simple tax return</rdf:li>
               <rdf:li>partner's individual tax return</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">If you are a member of a partnership; use the short version of the SA104(2026) for the year ended 5 April 2026 if you are only declaring trading income; and interest or alternative finance receipts received after tax from banks or building societies</rdf:li>
            </rdf:Alt>
         </dc:description>
