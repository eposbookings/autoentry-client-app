         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Foreign (2026)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>tax return for income gained overseas</rdf:li>
               <rdf:li>income from abroad</rdf:li>
               <rdf:li>individual tax return for foreign gains</rdf:li>
               <rdf:li>foreign profits for tax return</rdf:li>
               <rdf:li>SA106 (Supplementary Pages)</rdf:li>
               <rdf:li>SA106</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Use the SA106(2026) supplementary pages to declare foreign income and gains and claim for foreign tax credit relief when completing a tax return for the tax year ended 5 April 2026</rdf:li>
            </rdf:Alt>
         </dc:description>
