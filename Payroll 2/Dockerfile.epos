FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV PAYFLOW_NODE_PREVIEW=1
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PAYFLOW_NODE_PREVIEW=1
ENV PAYFLOW_LOCAL_DB=/data/payroll.sqlite
ENV PORT=3102
COPY --from=build /app /app
EXPOSE 3102
CMD ["sh", "-c", "node scripts/apply-local-migrations.mjs && npm run start"]
